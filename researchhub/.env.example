# Supabase Scholar — obrigatórias
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# URL canônica do ambiente
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PubMed — opcionais, mas recomendadas para uso real e limites mais estáveis
NCBI_EMAIL=
NCBI_API_KEY=

# Unpaywall — opcional; usa o e-mail público do produto quando vazio
UNPAYWALL_EMAIL=

# Backend privado — usado por alertas e pelo registro de franquia/gerações de IA.
# Configure diretamente na Vercel; nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# IA — integração direta com Google Gemini, sem passar pelo AI Gateway.
# Crie a chave no Google AI Studio e configure-a somente no servidor/Vercel.
GOOGLE_GENERATIVE_AI_API_KEY=
# "false" desliga explicitamente a IA; "true" permite também fora de Preview.
SCHOLAR_AI_ENABLED=false
SCHOLAR_AI_MODEL=gemini-3.5-flash
