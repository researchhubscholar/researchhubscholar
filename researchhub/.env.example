# Supabase Scholar — obrigatórias
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# URL canônica do ambiente
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PubMed — opcionais, mas recomendadas para uso real e limites mais estáveis
NCBI_EMAIL=
NCBI_API_KEY=

# Unpaywall — opcional; usa o e-mail público do produto quando vazio
UNPAYWALL_EMAIL=

# Alertas automáticos — somente no servidor, nunca use prefixo NEXT_PUBLIC_
# Configure diretamente na Vercel quando a execução diária for para Produção.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
